{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/tools",
      "destination": "/olympus",
      "permanent": true
    },
    {
      "source": "/tools/:path*",
      "destination": "/olympus/:path*",
      "permanent": true
    },
    {
      "source": "/olympus/inicio-scroll",
      "destination": "/olympus",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
